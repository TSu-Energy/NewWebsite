---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
// import Announcement from '~/components/widgets/Announcement.astro';

import { getLocalizedNavigation } from '~/navigation';

import type { MetaData } from '~/types';

export interface Props {
  metadata?: MetaData;
  lang?: string;
}

const { metadata, lang } = Astro.props;
console.log('lang:', lang);
const { header, footer } = getLocalizedNavigation(lang);
console.log(header);
---

<Layout metadata={metadata}>
  <!-- 必要时，可以释放 Announcement -->
  <!-- <slot name="announcement" class="z-1000">
    <Announcement />
  </slot> -->

  <slot name="header">
    <Header {...header} lang={lang} isSticky position="free" isDark />
  </slot>

  <main>
    <slot />
  </main>

  <slot name="footer">
    <Footer {...footer} />
  </slot>
</Layout>
