---
import Image from "~/components/common/Image.astro";

// Props to pass to the component
export interface StepProps {
  imageSrc: string;
  altText: string;
  title: string;
  description: string;
  additionalInfo: string;
}

const { imageSrc, altText, title, description, additionalInfo } = Astro.props;
---

<div class="flex flex-col items-center text-center">
  <Image src={imageSrc} alt={altText} class="w-28 h-28" loading="lazy" />
  <h3 class="text-lg font-semibold text-gray-700 mt-4">{title}</h3>
  <p class="text-gray-600 mt-2">{description}</p>
  <desc class="text-sm text-gray-500 mt-1">{additionalInfo}</desc>
</div>
