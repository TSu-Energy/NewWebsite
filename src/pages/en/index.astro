---
import Layout from '~/layouts/PageLayout.astro';
import BrandsGray from '~/components/widgets/BrandsGray.astro';
import RollingViews from '~/components/sections/RollingViews.astro';
import Stats2 from '~/components/widgets/Stats2.astro';
import IntroValueSection from '~/components/sections/IntroValueSection.astro';
import FrontHeroContainer from '~/components/sections/FrontHeroContainer.astro';
import GlobalService from '~/components/sections/GlobalService.astro';
import CallForActionSection from '~/components/sections/CallForActionSection.astro';

const metadata = {
  title: 'TSu-Energy — 天苏能源',
  ignoreTitleTemplate: true,
};

const stats = [
  { title: 'Downloads', amount: 132, unit: 'K', id: 'downloads-id' },
  { title: 'Stars', amount: 24, unit: 'K', id: 'starts-id' },
  { title: 'Forks', amount: 10, unit: 'K', id: 'forks-id' },
  { title: 'Users', amount: 48, unit: 'K', id: 'users-id' },
];
---

<Layout metadata={metadata} lang='en'>
  <!-- HeroContainer ***************** -->
  <FrontHeroContainer />

  <Stats2
    tagline="our influence"
    title="我们的影响力"
    subtitle="以下数字反映了用户对我们的信任以及我们帮助他们取得的卓越成果。"
    stats={stats}
  />

  <!-- 分割线 -->
  <hr class="mb-12 border-t border-gray-200 dark:border-gray-800" />
  <IntroValueSection />

  <GlobalService />

  <BrandsGray
    tagline="our clients"
    title="客户与合作伙伴"
    subtitle="我们与全球领先企业和机构建立长期服务与合作关系，共同塑造可持续未来"
  />

  <!-- 分割线 -->
  <hr class="my-12 border-t border-gray-200 dark:border-gray-800" />

  <RollingViews id="news" tagline="News" title="天苏最新咨询" />

  <CallForActionSection url="~/assets/images/resource/wegreenpass-background.jpeg" />
</Layout>
