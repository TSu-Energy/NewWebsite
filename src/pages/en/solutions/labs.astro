---
import Hero from '~/components/widgets/Hero.astro';
import SolutionSection from '~/components/widgets/SolutionSection.astro';
import LabsBroadSection from '~/components/widgets/LabsBroadSection.astro';
import LabsPreSection from '~/components/sections/LabsPreSection.astro';
import Layout from '~/layouts/PageLayout.astro';
import CallForActionSection from '~/components/sections/CallForActionSection.astro';

const metadata = {
  title: 'Labs - 实验室和认证机构',
};
---

<Layout metadata={metadata} lang="en">
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="Labs"
    title="实验室和认证机构"
    subtitle="我们协助实验室和认证流程实现更高的自动化和智能化水平"
    actions={[{ variant: 'primary', target: '_blank', text: '联系我们', href: '/about' }]}
    image={{
      src: '~/assets/images/solutions/labs/switch-labs-background.png',
      alt: 'AstroWind Hero Image',
    }}
  />

  <SolutionSection />

  <LabsPreSection />

  <LabsBroadSection />

  <CallForActionSection url="~/assets/images/resource/wegreenpass-background.jpeg" />
</Layout>
