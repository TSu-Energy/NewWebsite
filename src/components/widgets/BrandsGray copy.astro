---
import Headline from '../ui/Headline.astro';
import Image from '../common/Image.astro';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;
---

<section class="container mt-20">
  <Headline
    title={title}
    subtitle={subtitle}
    tagline={tagline}
    classes={{
      container: 'max-w-xl sm:mx-auto lg:max-w-2xl',
      title: 'text-4xl md:text-5xl font-bold tracking-tighter mb-4 font-heading',
      subtitle: 'max-w-3xl mx-auto sm:text-center text-xl text-muted dark:text-slate-400',
    }}
  />
  <div class="scroll-container">
    <div class="scrolling-wrapper">
      <Image
        src="~/assets/images/clients/huawei-2.svg"
        class="h-20 w-20 mx-auto"
        alt="client logo"
        width=""
        height=""
      />
      <Image
        src="~/assets/images/clients/stategr-2.svg"
        class="h-20 w-20 mx-auto"
        alt="client logo"
        width=""
        height=""
      />
      <Image
        src="~/assets/images/clients/xiaopeng-2.svg"
        class="h-20 w-20 mx-auto"
        alt="client logo"
        width=""
        height=""
      />
      <Image
        src="~/assets/images/clients/huawei-2.svg"
        class="h-20 w-20 mx-auto"
        alt="client logo"
        width=""
        height=""
      />
      <Image
        src="~/assets/images/clients/stategr-2.svg"
        class="h-20 w-20 mx-auto"
        alt="client logo"
        width=""
        height=""
      />
      <Image
        src="~/assets/images/clients/xiaopeng-2.svg"
        class="h-20 w-20 mx-auto"
        alt="client logo"
        width=""
        height=""
      />

      <!-- 可以添加更多logo -->
    </div>
  </div>
</section>

<style>
  .container {
    overflow: hidden;
    max-width: none;
    width: 100%;
  }
  .scroll-container {
    overflow: visible;
    width: 200%; /* 或根据需要调整 */
    height: auto;
    display: flex;
  }

  .scrolling-wrapper {
    white-space: nowrap;
    display: flex;
    animation: scroll-left 10s linear infinite;
  }

  .scrolling-wrapper2 {
    white-space: nowrap;
    display: flex;
    animation: scroll-right 10s linear infinite;
  }

  .scrolling-wrapper .logo {
    height: 80px; /* 根据需求调整 */
    margin-right: 30%; /* logo之间的间隔 */
  }

  @keyframes scroll-left {
    from {
      transform: translateX(0%);
    }
    to {
      transform: translateX(-50%); /* 滚动至第一组logo的末尾 */
    }
  }

  @keyframes scroll-right {
    from {
      transform: translateX(-50%);
    }
    to {
      transform: translateX(50%); /* 滚动至第一组logo的末尾 */
    }
  }
</style>
