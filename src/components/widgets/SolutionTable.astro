---
export interface Props {
  sectionTitle: string;
  rows: Array<{
    demandTitle: string;
    demandItems: Array<string>;
    solutionTitle: string;
    solutionItems: Array<string>;
  }>;
}

const { sectionTitle, rows } = Astro.props;
---

<section class="bg-gray-100 py-16 px-4">
  <!-- Section Heading -->
  <div class="max-w-4xl mx-auto text-center mb-12">
    <h2 class="text-2xl md:text-3xl font-bold text-gray-800">
      {sectionTitle}
    </h2>
  </div>

  <!-- Content Table -->
  <div class="overflow-x-auto">
    <table class="w-full max-w-5xl mx-auto text-left text-gray-700 border-collapse">
      <!-- Table Header -->
      <thead>
        <tr>
          <th class="p-4 text-lg font-semibold bg-gray-200">您的潜在需求</th>
          <th></th>
          <th class="p-4 text-lg font-semibold bg-gray-200">我们的解决方案</th>
        </tr>
      </thead>

      <!-- Table Body -->
      <tbody>
        {
          rows.map((row, index) => (
            <tr class={index % 2 === 0 ? 'bg-white border-t' : 'bg-gray-50 border-t'}>
              <td class="p-4">
                <h4 class="font-semibold text-gray-800">{row.demandTitle}</h4>
                <ul class="list-disc ml-6 mt-2 text-sm text-gray-600 space-y-2">
                  {row.demandItems.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </td>
              <td class="text-center">
                <span class="text-blue-600 text-xl"> ➡ </span>
              </td>
              <td class="p-4">
                <h4 class="font-semibold text-gray-800">{row.solutionTitle}</h4>
                <ul class="list-disc ml-6 mt-2 text-sm text-gray-600 space-y-2">
                  {row.solutionItems.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>
