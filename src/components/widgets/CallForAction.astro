---
import Image from '~/components/common/Image.astro';

export interface Props {
  title?: string;
  description?: string;
  buttonText?: string;
  buttonLink?: string;
  backgroundImageUrl?: string;
}

const {
  title = await Astro.slots.render('title'),
  description = await Astro.slots.render('description'),
  buttonText = '联系我们',
  buttonLink = '/about',
  backgroundImageUrl = '~/assets/images/resource/wegreenpass-background.jpeg',
} = Astro.props;
---

<section class="relative bg-gray-900 text-white">
  <div class="absolute inset-0">
    <Image src={backgroundImageUrl} alt="background" class="h-full w-full object-cover" />
  </div>

  <!-- 半透明遮罩 -->
  <div class="absolute inset-0 bg-black/40 mt-8 mb-8"></div>

  <div class="relative z-10 flex flex-col items-center justify-center py-20 px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <h3 class="text-3xl sm:text-4xl font-bold mb-4">
        {title}
      </h3>
      <p class="text-lg sm:text-xl mb-6">
        {description}
      </p>
    </div>

    <button
      class="bg-primary text-white font-semibold rounded-full px-8 py-3 hover:bg-primary-dark transition-transform transform hover:scale-105"
      data-umami-event="call-for-action-button"
    >
      <a href={buttonLink} target="_blank" class="flex items-center space-x-2">
        <span>{buttonText}</span>
        <svg
          class="w-5 h-5"
          viewBox="64 64 896 896"
          focusable="false"
          data-icon="arrow-right"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M869 487.8L491.2 159.9c-2.9-2.5-6.6-3.9-10.5-3.9h-88.5c-7.4 0-10.8 9.2-5.2 14l350.2 304H152c-4.4 0-8 3.6-8 8v60c0 4.4 3.6 8 8 8h585.1L386.9 854c-5.6 4.9-2.2 14 5.2 14h91.5c1.9 0 3.8-.7 5.2-2L869 536.2a32.07 32.07 0 000-48.4z"
          ></path>
        </svg>
      </a>
    </button>
  </div>
</section>
