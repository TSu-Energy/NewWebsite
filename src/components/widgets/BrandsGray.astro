---
import Headline from '../ui/Headline.astro';
import Image from '../common/Image.astro';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;
---

<section class="container mt-20">
  <Headline
    title={title}
    subtitle={subtitle}
    tagline={tagline}
    classes={{
      container: 'max-w-xl sm:mx-auto lg:max-w-2xl',
      title: 'text-4xl md:text-5xl font-bold tracking-tighter mb-4 font-heading',
      subtitle: 'max-w-3xl mx-auto sm:text-center text-xl text-muted dark:text-slate-400',
    }}
  />
  <div class="scroll-container">
    <div class="scrolling-wrapper">
      <div class="logo">
        <Image src="~/assets/images/clients/huawei-2.svg" class="m-80" alt="client logo" />
      </div>
      <div class="logo">
        <Image src="~/assets/images/clients/stategr-2.svg" alt="client logo" />
      </div>
      <div class="logo">
        <Image src="~/assets/images/clients/xiaopeng-2.svg" alt="client logo" />
      </div>
      <div class="logo">
        <Image src="~/assets/images/clients/google.svg" class="m-80" alt="client logo" />
      </div>
      <div class="logo">
        <Image src="~/assets/images/clients/huawei-2.svg" class="m-80" alt="client logo" />
      </div>
      <div class="logo">
        <Image src="~/assets/images/clients/stategr-2.svg" alt="client logo" />
      </div>
      <div class="logo">
        <Image src="~/assets/images/clients/xiaopeng-2.svg" alt="client logo" />
      </div>
      <div class="logo">
        <Image src="~/assets/images/clients/google.svg" class="m-80" alt="client logo" />
      </div>
    </div>
  </div>
</section>

<style>
  .container {
    overflow: hidden;
    max-width: none;
    width: 100%;
  }
  .scroll-container {
    overflow: visible;
    width: 200%;
    height: auto;
    display: flex;
  }

  .scrolling-wrapper {
    white-space: nowrap;
    display: flex;
    animation: scroll-left 10s linear infinite;
  }

  .logo {
    flex: 0 0 120px;
    width: 120px;
    height: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #fff; /* 可选的背景颜色 */
    border-radius: 50%; /* 使其看起来像图标容器 */
    margin: auto;
  }

  .logo img {
    /* max-width: 70px;
    max-height: 100%; */
    object-fit: contain;
  }

  @keyframes scroll-left {
    from {
      transform: translateX(0%);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @keyframes scroll-right {
    from {
      transform: translateX(-50%);
    }
    to {
      transform: translateX(50%); /* 滚动至第一组logo的末尾 */
    }
  }
</style>
