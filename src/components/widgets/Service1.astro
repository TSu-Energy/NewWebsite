---
import Card from '../common/Card.astro';
import CollapseItem from '../common/CollapseItem.astro';
import CollapseList from '../common/CollapseList.astro';
---

<section class="relative overflow-hidden">
  <!-- 背景 -->
  <div class="absolute inset-0 bg-cover bg-center"></div>

  <!-- 地图图片 -->
  <div class="relative flex justify-center items-center">
    <img
      alt="地图的背景图片"
      loading="lazy"
      decoding="async"
      width="3500"
      height="1750"
      class="w-full h-auto"
      src="./images/resource/image-from-rawpixel-id-440239-jpeg.jpeg"
    />

    <!-- 图钉 -->
    <div class="absolute" style="top:33%;left:84%;margin-left:-16px;margin-top:-16px">
      <div class="w-4 h-4 rounded-full bg-[#23b375] relative"></div>
      <div
        class="absolute top-1/2 left-1/2 w-4 h-4 transform -translate-x-1/2 -translate-y-1/2 rounded-full bg-gradient-radial from-transparent via-[#23b37533] to-[#23b37500]"
      >
      </div>
    </div>

    <div class="absolute" style="top:24%;left:53%;margin-left:-16px;margin-top:-16px">
      <div class="w-4 h-4 rounded-full bg-[#3bbeee] relative"></div>
      <div
        class="absolute top-1/2 left-1/2 w-4 h-4 transform -translate-x-1/2 -translate-y-1/2 rounded-full bg-gradient-radial from-transparent via-[#23b37533] to-[#23b37500]"
      >
      </div>
    </div>

    <div class="absolute" style="top:31%;left:81%;margin-left:-16px;margin-top:-16px">
      <div class="w-4 h-4 rounded-full bg-[#d9c61e] relative"></div>
      <div
        class="absolute top-1/2 left-1/2 w-4 h-4 transform -translate-x-1/2 -translate-y-1/2 rounded-full bg-gradient-radial from-transparent via-[#23b37533] to-[#23b37500]"
      >
      </div>
    </div>

    <div class="absolute" style="top:21%;left:50%;margin-left:-16px;margin-top:-16px">
      <div class="w-4 h-4 rounded-full bg-[#ff29b4] relative"></div>
      <div
        class="absolute top-1/2 left-1/2 w-4 h-4 transform -translate-x-1/2 -translate-y-1/2 rounded-full bg-gradient-radial from-transparent via-[#23b37533] to-[#23b37500]"
      >
      </div>
    </div>
  </div>

