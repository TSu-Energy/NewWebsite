---
// Card.astro
interface Props {
  title: string;
  items: string[];
}

const { title, items } = Astro.props;
---

<div class="p-4 border rounded-md shadow-md">
  <h4 class="font-bold text-lg">{title}</h4>
  <ul class="mt-2 space-y-2">
    {items.map((item) => <li class="text-sm">{item}</li>)}
  </ul>
</div>
