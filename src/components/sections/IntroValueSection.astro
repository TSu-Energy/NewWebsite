---
const sectionTitle = '领先气候科技和可持续解决方案提供商';
const sectionDescription =
  '我们致力于以先进技术赋能全球供应链从合规、制造、认证、跨境贸易到 ESG 管理等各个环节的可持续发展，推动企业创造实际价值和商业影响力，加速全球供应链绿色转型。';
const buttonText = '了解更多';
const valuePropositions = [
  {
    title: 'AI 解决方案',
    description: '我们通过创新技术，实现自动化的计量检测认证、碳排放管理、航运物流优化，构建面向未来的全球供应链。',
    icon: '🌐',
  },
  {
    title: 'ESG 咨询服务',
    description:
      '我们以技术赋能、政策前瞻、专业服务、资源网络四大优势为抓手，通过一站式高效服务，协助您在公司治理、日常运营和投融资等关键环节中，收获 ESG 建设成果，提升您在 ESG 和可持续发展领域的行业领导地位。',
    icon: '📘',
  },
  {
    title: '跨境贸易绿色服务',
    description:
      '依托于蔚碳科技不断壮大的生态圈，我们将为您的跨境绿色合规与全球重要市场联系建立全流程保驾护航，促进海外业务拓展与增长。',
    icon: '🚀',
  },
];
---

<section class="relative">
  <!-- 背景图片 -->
  <!-- <div
    class="absolute inset-0 bg-cover bg-center transition-opacity duration-500"
    style={{
      backgroundImage: './images/resourece/rainbow-earth-background.png',
      opacity: 0.6,
      backgroundSize: 'cover',
      backgroundPosition: 'center',
    }}
  >
  </div> -->

  <div class="relative z-10 px-6 py-20 md:px-12 lg:px-32">
    <div class="text-center max-w-3xl mx-auto">
      <h5 class="text-lg font-semibold">ABOUT US</h5>
      <h2 class="text-4xl md:text-5xl font-extrabold mt-4">{sectionTitle}</h2>
      <p class="text-lg mt-6 leading-relaxed">{sectionDescription}</p>

      <div class="mt-8">
        <a
          href="/about"
          class="inline-flex items-center justify-center px-8 py-3 text-white bg-blue-600 rounded-lg hover:bg-blue-700 transition"
        >
          <span>{buttonText}</span>
          <svg
            class="ml-2 w-5 h-5"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 16 16"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M8 1a7 7 0 1 0 7 7 7.007 7.007 0 0 0-7-7zm0 14A7 7 0 1 1 8 1a7.007 7.007 0 0 1 7 7zM8 2a6 6 0 1 1 6 6 6.007 6.007 0 0 1-6-6zm2 6H6a1 1 0 0 0-1 1v1h4v-1a1 1 0 0 0-1-1z"
            ></path>
          </svg>
        </a>
      </div>
    </div>

    <div class="mt-20 grid grid-cols-1 md:grid-cols-3 gap-8">
      {
        valuePropositions.map((prop, index) => (
          <div
            key={index}
            class="relative bg-white rounded-xl p-6 shadow-md hover:shadow-lg transition transform hover:-translate-y-2"
          >
            <div class="flex items-center justify-center w-12 h-12 bg-blue-100 rounded-full text-2xl mb-4">
              {prop.icon}
            </div>
            <h5 class="text-lg font-semibold dark:text-blue-700">{prop.title}</h5>
            <p class="text-sm mt-3 text-gray-700">{prop.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
