---

<section 
  class="relative overflow-hidden items-center justify-center bg-black min-h-screen"
>
  <div class="absolute inset-0 bg-cover bg-center"></div>

  <div
    class="relative bg-cover bg-center h-full"
    style="background-image: url('../images/resource/image-from-rawpixel-id-440239-jpeg.jpeg'); 
            width=:3500;
            height:1750;"
  >
    <div class="container mx-auto px-6 py-12 relative z-10">
      <!-- 文本标题 -->
      <div class="text-center bg-black bg-opacity-50 p-6 rounded-md mt-48">
        <h1 class="text-3xl md:text-4xl font-bold mb-4">跨境贸易绿色服务</h1>
        <p class="text-lg mb-4">您值得信赖的「跨境可持续发展协调中心」</p>
        <p class="text-sm text-gray-400">
          相比自行设立或贸易公司部门及扩张人员，将跨境绿色合规相关各类需求交给我们，
          为您提供省时、省力、专业的服务和相关资源保障。
        </p>
      </div>

      <!-- 地点标记 -->
      <div class="relative mt-12">
        <div
          class="absolute top-1/3 left-1/4 transform -translate-y-1/2 bg-green-500 text-white text-xs py-1 px-3 rounded shadow-lg"
        >
          中国上海
        </div>
        <div
          class="absolute top-1/4 left-2/3 transform -translate-y-1/2 bg-blue-500 text-white text-xs py-1 px-3 rounded shadow-lg"
        >
          德国慕尼黑
        </div>
        <div
          class="absolute bottom-1/3 left-1/2 transform -translate-x-1/2 bg-pink-500 text-white text-xs py-1 px-3 rounded shadow-lg"
        >
          英国伦敦
        </div>
      </div>
    </div>

    <!-- 内容部分 -->
    <div class="container mx-auto px-6 py-12">
      <!-- 卡片部分 -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-8">
        <div class="bg-gray-800 p-6 rounded-md shadow-md text-center">
          <h2 class="text-lg font-bold mb-2">线上平台</h2>
          <ul class="space-y-2">
            <li class="text-sm text-gray-300">「绿通」CBAM 线上申报平台</li>
            <li class="text-sm text-gray-300">跨境合规政策自测工具</li>
          </ul>
        </div>
        <div class="bg-gray-800 p-6 rounded-md shadow-md text-center">
          <h2 class="text-lg font-bold mb-2">绿色金融</h2>
          <ul class="space-y-2">
            <li class="text-sm text-gray-300">绿色供应链金融</li>
            <li class="text-sm text-gray-300">贸易融资</li>
          </ul>
        </div>
        <div class="bg-gray-800 p-6 rounded-md shadow-md text-center">
          <h2 class="text-lg font-bold mb-2">跨境服务</h2>
          <ul class="space-y-2">
            <li class="text-sm text-gray-300">企业出海咨询</li>
            <li class="text-sm text-gray-300">海外品牌建设及业务拓展对接</li>
          </ul>
        </div>
      </div>

      <!-- 专业服务 -->
      <div class="mt-12 text-center">
        <h2 class="text-2xl font-bold mb-4">专业服务</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <div class="bg-gray-700 py-4 px-6 rounded-md shadow-md">
            <p class="text-sm text-gray-300">组织碳盘查</p>
          </div>
          <div class="bg-gray-700 py-4 px-6 rounded-md shadow-md">
            <p class="text-sm text-gray-300">产品碳足迹</p>
          </div>
          <div class="bg-gray-700 py-4 px-6 rounded-md shadow-md">
            <p class="text-sm text-gray-300">CSRD/CSDDD/ESPR 合规</p>
          </div>
          <div class="bg-gray-700 py-4 px-6 rounded-md shadow-md">
            <p class="text-sm text-gray-300">供应链全碳咨询</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
